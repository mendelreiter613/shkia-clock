# Copy to .env.local for local dev. These same three are set in Vercel
# (Project > Settings > Environment Variables). All of them are public
# values: the push private key and scheduler secret live only in Supabase,
# in public.shkia_settings.

# Web push public key (its private half is in shkia_settings)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Supabase project that holds the shkia_* tables and functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
